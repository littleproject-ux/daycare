rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: is user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: get user's org and role from Firestore
    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function orgId() {
      return userData().organizationId;
    }

    function role() {
      return userData().role;
    }

    function isAdmin() {
      return role() in ['owner', 'admin'];
    }

    function isStaff() {
      return role() in ['owner', 'admin', 'finance', 'caregiver'];
    }

    // Organization-scoped file storage: /orgs/{orgId}/...
    match /orgs/{orgIdPath}/{allPaths=**} {
      allow read: if isSignedIn() && orgId() == orgIdPath;
      allow write: if isSignedIn() && orgId() == orgIdPath && isStaff()
        && request.resource.size < 10 * 1024 * 1024  // 10 MB max
        && request.resource.contentType.matches('image/.*|application/pdf|application/vnd.openxmlformats.*');
      allow delete: if isSignedIn() && orgId() == orgIdPath && isAdmin();
    }
  }
}

+const parentNavSections: NavSection[] = [
+  {
+    items: [
+      { label: 'Beranda',        href: '/dashboard',           icon: <LayoutDashboard className="h-4 w-4" />, color: COLORS.sky    },
+      { label: 'Anak Saya',      href: '/anak',                icon: <Baby className="h-4 w-4" />,           color: COLORS.pink   },
